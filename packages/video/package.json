{
  "name": "dsh-video",
  "version": "0.1.0",
  "description": "让 DSH 里的 AI 生成视频：支持通义万相 Wan（阿里云 DashScope）与火山方舟（即梦 / Seedance）。在「设置 → 插件 → dsh-video」里填 Key 即可用。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video-generation",
    "wan",
    "seedance",
    "douyin"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4"
  }
}